load "idv.fl";


let pp =
wrap_pexlif (PINST "draw_adff 1 0" [("SHA","35dbc9ee7004ad7804ed36feaba9c50d527f6c422a1bf65c5043ca27611cf2af"),("FP","23393345075802"),("fl_src","/home/cseger/VossII/IDVII/src/fl/design/yosys_lib.fl:1267"),("src","/tmp/voss2_cseger_X1ct9e/ct_top_verilog_NlmBuV/ct_cp0_regs.v:1964.1-1972.4")] T
  [("D[63:0]",["_$69[63:0]"]),("CLK",["regs_clk"]),("ARST",["cpurst_b"])]
  [("Q[63:0]",["mscratch_value[63:0]"])]
  ["D_##_[63:0]","CLK_##_","Q_##_[63:0]"]
(P_LEAF [(W_PHASE_DELAY (W_VAR 1 "CLK_##_") (W_VAR 1 "CLK")), (W_PHASE_DELAY (W_VAR 64 "D_##_") (W_VAR 64 "D")), (W_PHASE_DELAY (W_VAR 64 "Q_##_") (W_VAR 64 "Q")), (W_UPDATE_FN (W_VAR 64 "Q") (W_ITE (W_NOT (W_VAR 1 "ARST")) (W_CONST 64 0) (W_ITE (W_AND (W_NOT (W_VAR 1 "CLK_##_")) (W_VAR 1 "CLK")) (W_VAR 64 "D_##_") (W_VAR 64 "Q_##_"))))])
);
let ckt = pexlif2fsm pp;
ckt;
let nd = "mscratch_value[0]";
is_latch ckt nd;


SIGNED "byte" 8;

ENUM "stages" ["INIT", "START_1", "START_2", "SHIFT", "PARITY"];
UNSIGNED "cnt" 4;

let UART_transmitter =
    bit_input       clk reset.
    bit_input       req.
    byte_input      din.
    bit_output      dout.
    //
    stages_internal state.
    cnt_internal    cnt.
    byte_internal   reg.
    bit_internal    done.
    bit_internal    parity.
    CELL "UART_transmitter" [
        Moore_FSM "uart_tr_fsm" clk state (reset --- INIT) [
            INIT    --- req  --- START_1,
            START_1 --- '1   --- START_2,
            START_2 --- '1   --- SHIFT,
            SHIFT   --- done --- PARITY,
            PARITY  --- '1   --- INIT
        ],
        STATE clk cnt [
            is_START_2 state --- '0,
            is_SHIFT state   --- cnt '+' '1
        ],
        done <- cnt '=' '7,
        STATE clk reg [
            is_INIT state '&' req --- din,
            is_SHIFT state        --- reg '>>' '1
        ],
        STATE clk parity [
            is_START_2 state --- '0,
            is_SHIFT state   --- parity '^' reg~~0
        ],
        CASE dout [
            is_START_1 state --- '0,
            is_START_2 state --- '0,
            is_SHIFT  state --- reg~~0,
            is_PARITY state --- parity
        ] '1
];

let p = flfun2pexlif UART_transmitter;
let ckt = pexlif2fsm p;

is_latch ckt "i1/_intermediate_state[0]";

let state = filter (is_latch ckt) (nodes ckt);
length state;
